@{
    ViewData["Title"] = "Home";
}

<div class="page-title">
    <span class="page-title-icon">⚽</span>
    <div>
        <h1 class="mb-0">Balanced Soccer Team Generator</h1>
        <p class="team-generator-subtitle mb-0">
            Automatically create fair and competitive teams using player skills and rankings.
        </p>
    </div>
</div>

<div class="row mt-4">
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                What This App Does
            </div>
            <div class="card-body">
                <p>
                    This tool helps you generate balanced teams for friendly matches, practices, or tournaments.
                    It uses each player's skill profile to distribute them fairly across teams.
                </p>

                <ul>
                    <li>Tracks detailed player attributes</li>
                    <li>Calculates overall score automatically</li>
                    <li>Supports any number of teams</li>
                    <li>Ensures balanced total skill across teams</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                Quick Start
            </div>
            <div class="card-body">
                <ol>
                    <li>Add players to your roster using the <strong>Players</strong> page.</li>
                    <li>Go to <strong>Team Generator</strong> and select who's present.</li>
                    <li>Choose the number of teams.</li>
                    <li>Click <strong>Generate Teams</strong>.</li>
                </ol>

                <p class="mt-3 mb-2">
                    You can start here:
                </p>

                <a asp-controller="Players" asp-action="Index" class="btn btn-primary me-2">
                    Manage Players
                </a>
                <a asp-controller="Teams" asp-action="Generate" class="btn btn-success">
                    Generate Teams
                </a>
            </div>
        </div>
    </div>
</div>
