@model BalancedSoccerTeams.Models.Player

@{
    ViewData["Title"] = "Edit Player";
}

<h1>Edit Player</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="BallControl" class="form-label"></label>
        <input asp-for="BallControl" class="form-control" />
        <span asp-validation-for="BallControl" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PassingAccuracy" class="form-label"></label>
        <input asp-for="PassingAccuracy" class="form-control" />
        <span asp-validation-for="PassingAccuracy" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Dribbling" class="form-label"></label>
        <input asp-for="Dribbling" class="form-control" />
        <span asp-validation-for="Dribbling" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DefensiveAwareness" class="form-label"></label>
        <input asp-for="DefensiveAwareness" class="form-control" />
        <span asp-validation-for="DefensiveAwareness" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Shooting" class="form-label"></label>
        <input asp-for="Shooting" class="form-control" />
        <span asp-validation-for="Shooting" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
