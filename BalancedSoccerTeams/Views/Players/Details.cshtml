@model BalancedSoccerTeams.Models.Player

@{
    ViewData["Title"] = "Player Details";
}

<h1>Player Details</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Ball Control</dt>
        <dd class="col-sm-10">@Model.BallControl</dd>

        <dt class="col-sm-2">Passing Accuracy</dt>
        <dd class="col-sm-10">@Model.PassingAccuracy</dd>

        <dt class="col-sm-2">Dribbling</dt>
        <dd class="col-sm-10">@Model.Dribbling</dd>

        <dt class="col-sm-2">Defensive Awareness</dt>
        <dd class="col-sm-10">@Model.DefensiveAwareness</dd>

        <dt class="col-sm-2">Shooting</dt>
        <dd class="col-sm-10">@Model.Shooting</dd>

        <dt class="col-sm-2">Overall</dt>
        <dd class="col-sm-10">@Model.OverallScore.ToString("0.0")</dd>

        <dt class="col-sm-2">Rank</dt>
        <dd class="col-sm-10">@Model.Rank</dd>
    </dl>
</div>

<p>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</p>
