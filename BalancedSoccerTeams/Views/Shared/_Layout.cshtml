@{
    var title = ViewData["Title"] ?? "Balanced Soccer Teams";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - Balanced Soccer Teams</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BalancedSoccerTeams.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark app-navbar shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    ⚽ BalancedSoccerTeams
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link nav-link-main" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-main" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-main" asp-area="" asp-controller="Players" asp-action="Index">Players</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-main" asp-area="" asp-controller="Teams" asp-action="Generate">Team Generator</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="app-body">
        <main role="main" class="pb-4">
            <div class="container app-container">
                @RenderBody()
            </div>
        </main>
    </div>

    <footer class="app-footer border-top">
        <div class="container d-flex justify-content-between align-items-center py-3">
            <span class="text-muted small">
                &copy; @DateTime.Now.Year - Balanced Soccer Teams
            </span>
            <span class="text-muted small">
                Final Project – ASP.NET Core MVC
            </span>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
